# ============================================================
# EduTrack 설정 예시
# 이 파일을 복사해 .env 를 만들고 값을 채웁니다. (.env 는 git에 올라가지 않습니다)
# demo 모드는 .env 없이도 동작합니다. real 모드는 아래 '외부 DB' 값이 필요합니다.
# 실행 모드(demo/real)는 .\scripts\run.ps1 이 정하므로 여기서 DEBUG·데이터 출처를 바꾸지 않습니다.
# ============================================================

# --- 외부 DB (읽기 전용, real 모드에서 사용) ---
INTRANET_DB_HOST=
INTRANET_DB_PORT=3306
INTRANET_DB_NAME=
INTRANET_DB_USER=
INTRANET_DB_PASSWORD=

DSG_DB_HOST=
DSG_DB_PORT=3306
DSG_DB_NAME=
DSG_DB_USER=
DSG_DB_PASSWORD=

# --- 외부 DB 연결 안정화 ---
EXTERNAL_DB_CONN_MAX_AGE=60
EXTERNAL_DB_CONNECT_TIMEOUT=5
EXTERNAL_DB_READ_TIMEOUT=15

# --- 선택 항목 (비워 두면 기본값) ---
# DJANGO_SECRET_KEY=          배포할 때 반드시 긴 임의 문자열로 지정
# REDIS_URL=                  여러 서버가 캐시를 함께 쓸 때만 지정
# EXAM_DETAIL_CACHE_SECONDS=900
# STUDENT_INSIGHT_CACHE_SECONDS=1800
# MAX_REQUEST_UPLOAD_MB=25
# COURSE_RESOURCE_MAX_MB=25
# PASTED_IMAGE_MAX_MB=8
